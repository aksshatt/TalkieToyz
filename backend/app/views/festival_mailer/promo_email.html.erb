<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @festival['name'] %> — TalkieToys</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #f5f5f0; font-family: 'Helvetica Neue', Arial, sans-serif; }
    .wrapper { max-width: 600px; margin: 0 auto; padding: 24px 16px; }
    .card { background: #fff; border-radius: 20px; overflow: hidden; }
    .header {
      background: <%= @festival.dig('theme', 'banner_bg') || @festival.dig('theme', 'primary') %>;
      padding: 48px 32px;
      text-align: center;
    }
    .emoji { font-size: 56px; display: block; margin-bottom: 12px; }
    .header h1 { color: #fff; font-size: 28px; font-weight: 800; line-height: 1.2; text-shadow: 0 2px 8px rgba(0,0,0,0.2); }
    .body { padding: 36px 32px; }
    .greeting { font-size: 18px; font-weight: 700; color: #1a1a1a; margin-bottom: 16px; }
    .body p { font-size: 15px; line-height: 1.7; color: #444; margin-bottom: 16px; }
    .cta-wrap { text-align: center; margin: 28px 0; }
    .cta {
      display: inline-block;
      background: <%= @festival.dig('theme', 'primary') %>;
      color: #fff;
      text-decoration: none;
      font-weight: 700;
      font-size: 15px;
      padding: 14px 32px;
      border-radius: 100px;
    }
    .divider { height: 1px; background: #f0f0f0; margin: 24px 0; }
    .footer { padding: 0 32px 32px; text-align: center; }
    .footer p { font-size: 12px; color: #999; line-height: 1.6; }
    .footer a { color: #999; text-decoration: underline; }
    .brand { font-size: 13px; font-weight: 700; color: #ccc; margin-top: 16px; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="card">
      <div class="header">
        <span class="emoji"><%= @festival['emoji'] %></span>
        <h1><%= @festival['name'] %></h1>
      </div>
      <div class="body">
        <p class="greeting">Dear <%= @user.name.split(' ').first %>,</p>
        <p><strong><%= @festival['email_headline'] %></strong></p>
        <p><%= @festival['email_body'] %></p>
        <div class="cta-wrap">
          <a href="<%= @shop_url %>/shop" class="cta">Explore TalkieToys</a>
        </div>
        <div class="divider"></div>
        <p style="font-size:13px; color:#888;">Because every child deserves to be heard. 💛</p>
      </div>
      <div class="footer">
        <p>
          You're receiving this because you're a valued TalkieToys customer.<br>
          <a href="<%= @shop_url %>/notification-preferences">Manage preferences</a> &middot;
          <a href="<%= @shop_url %>">Visit our store</a>
        </p>
        <p class="brand">TalkieToys &mdash; Speech & Language Therapy Toys</p>
      </div>
    </div>
  </div>
</body>
</html>
